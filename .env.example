# ---- copy to .env (never commit .env) ----
DELTA_ENV=live               # live = real Delta India prices. testnet = demo exchange (needs demo-account keys)
DRY_RUN=1                    # 1 = PAPER trading, no orders, no keys needed. 0 = send real orders.
LIVE_CONFIRM=                # must be exactly I_UNDERSTAND_THE_RISK to trade live with DRY_RUN=0

DELTA_API_KEY=
DELTA_API_SECRET=
WALLET_ASSET=USD             # asset shown in /v2/wallet/balances. CONFIRM with: python bot.py --check

SYMBOLS=BTCUSD,ETHUSD,SOLUSD # comma separated; one position per symbol
PAPER_TIMEFRAMES=30m,1h      # ALSO paper-trade these (dashboard shows each separately). Never real orders.
PAPER_TRAIL_TIMEFRAMES=4h,1d # ALSO paper-trade these with a TRAILING STOP (no fixed target). Paper only.
TRAIL_ACTIVATE_R=1.0         # trailing starts once a trade is +1R in profit
TRAIL_ATR=2.0                # stop follows 2 x ATR behind the best close
RESOLUTION=4h                # 4h is what the strategy was tested on. 1h/2h lose money in the backtest
STRATEGY=pullback            # pullback (tested) | ema_cross (old, loses on 1h)
RSI_PULLBACK=40

BOT_CAPITAL_USD=500          # hard cap on the capital the bot may size against (same currency as WALLET_ASSET)
RISK_PER_TRADE=0.005         # 0.5% of capital lost when a stop is hit
MAX_LEVERAGE=2
DAILY_LOSS_LIMIT=0.03        # stop for the day at -3%
MAX_DRAWDOWN=0.10            # permanent halt at -10% from peak (manual reset)
MAX_TRADES_PER_DAY=3

ATR_STOP_MULT=1.5            # stop loss = 1.5 x ATR from entry
REWARD_RISK=3.0              # target = 3 x the stop distance
FEE_RATE=0.0006              # per side incl. GST, used by backtest and paper P&L

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
ML_MODEL_PATH=               # e.g. models/filter.joblib (optional)
ML_THRESHOLD=0.55
