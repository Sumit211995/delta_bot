# ---- copy to .env (never commit .env) ----
DELTA_ENV=testnet            # testnet | live
DRY_RUN=1                    # 1 = log orders only (no keys needed). Set 0 to send real orders.
LIVE_CONFIRM=                # must be exactly I_UNDERSTAND_THE_RISK to trade live with DRY_RUN=0

DELTA_API_KEY=
DELTA_API_SECRET=
WALLET_ASSET=USD             # asset shown in /v2/wallet/balances. CONFIRM with --check

SYMBOL=BTCUSD
RESOLUTION=1h                # 15m, 30m, 1h, 2h, 4h, 1d  (higher = fewer trades, less fee/tax drag)

BOT_CAPITAL_USD=500          # hard cap on the capital the bot may size against
RISK_PER_TRADE=0.005         # 0.5% of capital per trade
MAX_LEVERAGE=2
DAILY_LOSS_LIMIT=0.03        # stop for the day at -3%
MAX_DRAWDOWN=0.10            # permanent halt at -10% from peak (manual reset)
MAX_TRADES_PER_DAY=3

ATR_STOP_MULT=1.5
REWARD_RISK=2.0
FEE_RATE=0.0005              # per side, CHECK your Delta fee tier; used by backtest

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
ML_MODEL_PATH=               # e.g. models/filter.joblib (optional)
ML_THRESHOLD=0.55
